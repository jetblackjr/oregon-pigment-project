<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#30291f">
<title>Oregon Pigment Project</title>

<style>
:root{
  --ink:#29251f;
  --muted:#756d61;
  --paper:#f5f0e6;
  --card:#fffdf8;
  --line:#d9d0c1;
  --accent:#76542d;
  --accent2:#b9894a;
  --dark:#30291f;
  --danger:#9a3d2f;
  --green:#536b4d;
}

*{box-sizing:border-box}

html{
  scroll-behavior:smooth;
}

body{
  margin:0;
  background:var(--paper);
  color:var(--ink);
  font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
}

header{
  background:var(--dark);
  color:white;
  padding:10px 16px 12px;
  position:sticky;
  top:0;
  z-index:20;
  box-shadow:0 3px 16px #0003;
}

/* TOP BRAND */

.brandline{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:12px;
  flex-wrap:wrap;
  max-width:1100px;
  margin:auto;
}

.brand-text{
  min-width:0;
  flex:1 1 220px;
}

.kicker,
.eyebrow{
  letter-spacing:.16em;
  font-size:9px;
  font-weight:800;
  color:#caa36c;
}

.brandline h1{
  margin:2px 0 0;
  font-family:Georgia,serif;
  font-size:22px;
  line-height:1.05;
}

.brandline p{
  margin:3px 0 0;
  color:#d9cfbd;
  font-size:11px;
}

/* AUTH */

.auth-area{
  display:flex;
  align-items:center;
  gap:7px;
  flex-wrap:wrap;
  flex-shrink:0;
}

.auth-user{
  display:none;
  color:#d9cfbd;
  font-size:11px;
  max-width:130px;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.auth-button{
  border:1px solid #b99a6c;
  background:transparent;
  color:white;
  border-radius:8px;
  padding:7px 10px;
  font-size:11px;
  font-weight:700;
  cursor:pointer;
  white-space:nowrap;
}

.auth-button.primary{
  background:#b9894a;
  border-color:#b9894a;
  color:#241d15;
}

/* HERO — enlarged, carries the Painted Hills backdrop */

.hero{
  position:relative;
  height:170px;
  max-width:1100px;
  margin:12px auto 8px;
  border-radius:14px;
  overflow:hidden;
  background:
    linear-gradient(
      180deg,
      #7b96a0 0%,
      #d8b784 45%,
      #b9793f 100%
    );
}

.hero svg{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
}

.hero:after{
  content:"";
  position:absolute;
  inset:0;
  background:
    linear-gradient(
      100deg,
      #17140fd9 0%,
      #17140f66 45%,
      #17140f14 100%
    );
}

.hero-copy{
  position:absolute;
  z-index:1;
  left:18px;
  bottom:16px;
  max-width:600px;
}

.hero-copy h2{
  font-family:Georgia,serif;
  font-size:24px;
  line-height:1.08;
  margin:3px 0 4px;
  color:#fff;
}

.hero-copy p{
  margin:0;
  color:#eee7da;
  font-size:11.5px;
}

/* PALETTE */

.palette{
  display:flex;
  gap:4px;
  height:6px;
  max-width:1100px;
  margin:0 auto 8px;
}

.palette span{
  flex:1;
  border-radius:2px;
}

/* NAV */

nav{
  display:flex;
  gap:7px;
  max-width:1100px;
  margin:auto;
  overflow-x:auto;
  padding:0 0 1px;
  scrollbar-width:none;
}

nav::-webkit-scrollbar{
  display:none;
}

button,
.button{
  border:0;
  border-radius:9px;
  padding:9px 12px;
  font-weight:700;
  background:var(--accent);
  color:#fff;
  cursor:pointer;
  white-space:nowrap;
}

.secondary{
  background:#e8dfd0;
  color:var(--ink);
}

.danger{
  background:var(--danger);
}

.green{
  background:var(--green);
}

/* MAIN */

main{
  max-width:1100px;
  margin:auto;
  padding:15px 16px 30px;
}

.toolbar{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
  margin-bottom:14px;
}

.toolbar input{
  flex:1;
  min-width:220px;
}

input,
select,
textarea{
  width:100%;
  border:1px solid var(--line);
  border-radius:9px;
  padding:10px;
  background:#fffdf9;
  color:var(--ink);
  font:inherit;
}

textarea{
  min-height:90px;
  resize:vertical;
}

.card{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:13px;
  padding:15px;
  margin-bottom:13px;
  box-shadow:0 2px 10px #4b38200b;
}

.card h2{
  margin-top:0;
}

.grid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:11px;
}

.full{
  grid-column:1/-1;
}

label{
  font-size:11px;
  font-weight:750;
  color:var(--muted);
  display:block;
  margin-bottom:5px;
}

.gallery{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(125px,1fr));
  gap:8px;
}

.gallery img{
  width:100%;
  height:125px;
  object-fit:cover;
  border-radius:9px;
  border:1px solid var(--line);
}

.specimen{
  display:grid;
  grid-template-columns:105px 1fr;
  gap:13px;
  align-items:start;
}

.thumb{
  width:105px;
  height:105px;
  object-fit:cover;
  border-radius:9px;
  background:#e9e0d0;
}

.specimen h3{
  margin:0 0 5px;
  font-family:Georgia,serif;
}

.meta{
  color:var(--muted);
  font-size:12px;
}

.tags{
  display:flex;
  gap:5px;
  flex-wrap:wrap;
  margin-top:8px;
}

.tag{
  background:#eee5d7;
  border-radius:99px;
  padding:4px 8px;
  font-size:10px;
}

.hidden{
  display:none!important;
}

.row{
  display:flex;
  gap:8px;
  align-items:center;
  flex-wrap:wrap;
}

.right{
  margin-left:auto;
}

.notice{
  padding:10px;
  border-radius:9px;
  background:#efe5d2;
  font-size:13px;
  margin-bottom:12px;
}

.success{
  background:#e2ecd9;
}

.error{
  background:#f3ddd6;
  color:#6e251d;
}

.account-card{
  max-width:500px;
  margin:25px auto;
}

.account-card h2{
  font-family:Georgia,serif;
  margin-top:0;
}

.account-card p{
  color:var(--muted);
  font-size:13px;
  line-height:1.5;
}

.account-actions{
  display:flex;
  gap:8px;
  margin-top:10px;
  flex-wrap:wrap;
}

.user-badge{
  display:inline-flex;
  align-items:center;
  gap:5px;
  background:#eee5d7;
  border-radius:99px;
  padding:5px 9px;
  font-size:11px;
  color:var(--ink);
}

.lock-note{
  padding:10px;
  background:#efe5d2;
  border-radius:9px;
  font-size:12px;
  margin-bottom:12px;
}

.source-note{
  font-size:11px;
  color:var(--muted);
  line-height:1.45;
  margin:20px 2px 8px;
}

.status-inline{
  font-size:12px;
  color:#d9cfbd;
}

/* MOBILE */

@media(max-width:650px){

  header{
    padding:9px 12px 10px;
  }

  .brandline{
    gap:8px 12px;
  }

  .brandline h1{
    font-size:18px;
  }

  .brandline p{
    font-size:10px;
  }

  .kicker{
    font-size:8px;
  }

  .auth-user{
    display:none!important;
  }

  .auth-area{
    width:100%;
    justify-content:flex-start;
  }

  .auth-button{
    padding:7px 9px;
    font-size:10px;
  }

  .hero{
    height:140px;
    margin-top:8px;
  }

  .hero-copy{
    left:14px;
    bottom:12px;
  }

  .hero-copy h2{
    font-size:19px;
  }

  .hero-copy p{
    font-size:10px;
  }

  main{
    padding:12px 12px 25px;
  }

  .grid{
    grid-template-columns:1fr;
  }

  .specimen{
    grid-template-columns:82px 1fr;
  }

  .thumb{
    width:82px;
    height:82px;
  }
}
</style>
</head>

<body>

<div id="authBar" class="authbar"></div>

<main>

<section id="authView" class="hidden">
  <div class="card auth-card">

    <div class="row">
      <h2 id="authTitle" style="font-family:Georgia,serif;margin:0">
        Sign in
      </h2>
    </div>

    <p class="meta" id="authIntro">
      Sign in to create and manage your private specimen collection.
    </p>

    <div class="grid">

      <div class="full">
        <label>Email</label>
        <input
          id="authEmail"
          type="email"
          autocomplete="email"
          placeholder="you@example.com"
        >
      </div>

      <div class="full">
        <label>Password</label>
        <input
          id="authPassword"
          type="password"
          autocomplete="current-password"
          placeholder="Password"
        >
      </div>

    </div>

    <div class="row" style="margin-top:12px">

      <button
        id="authSubmit"
        onclick="submitAuth()"
      >
        Sign in
      </button>

      <button
        class="secondary"
        onclick="showAuth('signup')"
      >
        Create account
      </button>

      <button
        class="secondary"
        onclick="show('list')"
      >
        Browse public catalog
      </button>

    </div>

    <div
      id="authStatus"
      class="notice hidden"
      style="margin-top:12px"
    ></div>

  </div>
</section>

<!-- YOUR EXISTING LIST VIEW AND FORM VIEW GO BELOW THIS LINE -->


<header>

  <div class="brandline">

    <div class="brand-text">
      <div class="kicker">OREGON · EARTH · COLOR</div>
      <h1>Oregon Pigment Project</h1>
      <p>Field Guide &amp; Natural Color Atlas</p>
    </div>

    <div class="auth-area">
      <span id="authUser" class="auth-user"></span>
      <button id="signInBtn" class="auth-button" onclick="showAuth('signin')">
        Sign in
      </button>
      <button id="signUpBtn" class="auth-button primary" onclick="showAuth('signup')">
        Create account
      </button>
      <button id="signOutBtn" class="auth-button hidden" onclick="signOut()">
        Sign out
      </button>
    </div>

  </div>

  <div class="hero">

    <svg viewBox="0 0 600 260" preserveAspectRatio="xMidYMax slice" aria-hidden="true">

      <!-- sky wash -->
      <rect x="0" y="0" width="600" height="260" fill="#8aa2ab"></rect>
      <circle cx="500" cy="55" r="34" fill="#f3d9a4" opacity=".8"></circle>

      <!-- Painted Hills style banded strata, back ridge -->
      <path d="M0,260 L0,150 L60,120 L120,145 L190,105 L260,140 L330,100 L410,150 L480,115 L540,150 L600,120 L600,260 Z" fill="#a9895f"></path>

      <!-- mid band: red / rust -->
      <path d="M0,260 L0,175 L70,150 L140,172 L210,140 L280,168 L350,135 L430,172 L500,145 L560,175 L600,155 L600,260 Z" fill="#9c5136"></path>

      <!-- band: ochre / gold -->
      <path d="M0,260 L0,195 L65,178 L135,198 L205,172 L275,196 L345,168 L425,198 L495,175 L555,198 L600,182 L600,260 Z" fill="#c98a3f"></path>

      <!-- band: deep umber -->
      <path d="M0,260 L0,212 L70,200 L145,215 L215,196 L285,214 L355,192 L435,216 L505,198 L565,216 L600,204 L600,260 Z" fill="#6b3f2a"></path>

      <!-- band: pale clay highlight -->
      <path d="M0,260 L0,228 L75,220 L150,230 L220,216 L295,228 L360,212 L440,230 L510,218 L570,230 L600,222 L600,260 Z" fill="#e3c79a"></path>

      <!-- foreground ridge, near-black for depth -->
      <path d="M0,260 L0,240 L90,232 L180,244 L270,228 L360,244 L450,230 L540,244 L600,236 L600,260 Z" fill="#3a2418"></path>

    </svg>

    <div class="hero-copy">
      <span class="eyebrow">FIELD JOURNAL</span>
      <h2>Color gathered from the Oregon landscape.</h2>
      <p>Document from raw material to processed pigment.</p>
    </div>

  </div>

  <div class="palette" aria-label="Oregon-inspired palette">
    <span style="background:#6e4b2b"></span>
    <span style="background:#a86d3b"></span>
    <span style="background:#c58b52"></span>
    <span style="background:#8f7f5d"></span>
    <span style="background:#3f5c58"></span>
    <span style="background:#6c8792"></span>
    <span style="background:#d7c8a8"></span>
  </div>

  <nav>

    <button onclick="show('list')">
      Collection
    </button>

    <button onclick="requireAuthForNew()">
      + New Specimen
    </button>

    <button class="secondary" onclick="backup()">
      Private Backup
    </button>

    <button class="secondary" onclick="exportPublic()">
      Export Public Catalog
    </button>

  </nav>

</header>


<main>

  <div id="status"
       class="notice hidden"
       role="status"
       aria-live="polite">
  </div>


  <!-- AUTH SCREEN -->

  <section id="authView" class="hidden">

    <div class="card account-card">

      <h2 id="authTitle">Create your OPP account</h2>

      <p id="authDescription">
        Create an account to save specimens to the Oregon Pigment Project database.
        Your private specimens remain visible only to you.
      </p>

      <div id="authEmailWrap">
        <label>Email</label>
        <input
          id="authEmail"
          type="email"
          autocomplete="email"
          placeholder="you@example.com">
      </div>

      <div id="authPasswordWrap" style="margin-top:10px">
        <label>Password</label>
        <input
          id="authPassword"
          type="password"
          autocomplete="new-password"
          placeholder="At least 6 characters">
      </div>

      <div class="account-actions">

        <button id="authSubmit" onclick="submitAuth()">
          Create account
        </button>

        <button
          id="authSwitch"
          class="secondary"
          onclick="switchAuthMode()">
          Already have an account?
        </button>

        <button
          class="secondary"
          onclick="show('list')">
          Back to collection
        </button>

      </div>

      <p id="authMessage"
         class="meta"
         style="margin-top:12px">
      </p>

    </div>

  </section>


  <!-- COLLECTION -->

  <section id="listView">

    <div id="loginNotice" class="lock-note hidden">
      Sign in to create and manage your own specimens.
      Public specimens can still be browsed without an account.
    </div>

    <div class="toolbar">

      <input
        id="search"
        placeholder="Search ID, material, place, color, tags…">

      <select id="filter">
        <option value="">All specimens</option>
        <option>Raw material</option>
        <option>Processed pigment</option>
        <option>Finished sample</option>
      </select>

      <select id="visibility">
        <option value="all">Public + my specimens</option>
        <option value="public">Public specimens only</option>
        <option value="mine">My specimens only</option>
      </select>

    </div>

    <div id="list"></div>

  </section>


  <!-- SPECIMEN FORM -->

  <section id="formView" class="hidden">

    <div class="card">

      <div class="row">

        <h2
          id="formTitle"
          style="font-family:Georgia,serif;margin:0">
          New specimen
        </h2>

        <span
          class="right meta"
          id="specimenId">
        </span>

      </div>

      <div
        id="privateWarning"
        class="lock-note"
        style="margin-top:12px">
        This specimen is private unless you choose to include it in the public catalog.
      </div>

      <div class="grid">

        <div>
          <label>Catalog stage</label>

          <select id="stage">
            <option>Raw material</option>
            <option>Processed pigment</option>
            <option>Finished sample</option>
          </select>
        </div>


        <div>
          <label>Collection date</label>
          <input id="date" type="date">
        </div>


        <div>
          <label>Collector</label>
          <input
            id="collector"
            placeholder="Name / initials">
        </div>


        <div>
          <label>Source / provenance</label>
          <input
            id="source"
            placeholder="Natural outcrop, road cut, mine tailings, etc.">
        </div>


        <div class="full">
          <label>Specimen name / working name</label>
          <input
            id="name"
            placeholder="e.g. Red Ochre — Smith Rock">
        </div>


        <div>
          <label>Material / suspected mineral</label>
          <input
            id="material"
            placeholder="Iron oxide, clay, basalt…">
        </div>


        <div>
          <label>Geologic setting</label>
          <input
            id="geology"
            placeholder="Basalt flow, river deposit, weathered zone…">
        </div>


        <div>
          <label>Locality / nearest place</label>
          <input id="locality">
        </div>


        <div>
          <label>GPS latitude</label>
          <input
            id="lat"
            inputmode="decimal">
        </div>


        <div>
          <label>GPS longitude</label>
          <input
            id="lon"
            inputmode="decimal">
        </div>


        <div class="full">

          <button
            type="button"
            onclick="locate()">
            📍 Capture current GPS location
          </button>

          <span
            id="locStatus"
            class="meta"
            style="margin-left:8px">
          </span>

        </div>


        <div>
          <label>Color — field observation</label>
          <input
            id="color"
            placeholder="red-brown, yellow ochre…">
        </div>


        <div>
          <label>Color code / Munsell / HEX</label>
          <input id="colorCode">
        </div>


        <div>
          <label>Texture / grain</label>
          <input id="texture">
        </div>


        <div>
          <label>Luster</label>
          <input id="luster">
        </div>


        <div>
          <label>Hardness</label>
          <input
            id="hardness"
            placeholder="Mohs / scratch observations">
        </div>


        <div>
          <label>Streak</label>
          <input id="streak">
        </div>


        <div>
          <label>Magnetic</label>

          <select id="magnetic">
            <option></option>
            <option>No</option>
            <option>Weak</option>
            <option>Strong</option>
          </select>

        </div>


        <div>
          <label>Acid / vinegar reaction</label>
          <input id="reaction">
        </div>


        <div>
          <label>Moisture / condition</label>
          <input
            id="condition"
            placeholder="Dry, damp, crumbly, consolidated…">
        </div>


        <div>
          <label>Approx. quantity</label>
          <input
            id="quantity"
            placeholder="Weight / volume / bag count">
        </div>


        <div>
          <label>Storage location</label>
          <input
            id="storage"
            placeholder="Box 01 / Jar R-004">
        </div>


        <div class="full">

          <label style="display:flex;align-items:center;gap:6px">

            <input
              id="publicShare"
              type="checkbox"
              style="width:auto">

            Include this specimen in the public catalog

          </label>

          <div class="meta">
            Public specimens can be viewed by anyone.
            Private GPS, storage, and collection notes are not shown publicly.
          </div>

        </div>


        <div class="full">

          <label>Collection notes</label>

          <textarea
            id="notes"
            placeholder="What did the outcrop look like? Associated rocks? Vein, soil horizon, stream sediment?">
          </textarea>

        </div>

      </div>

    </div>


    <!-- PHOTOS -->

    <div class="card">

      <h2 style="font-family:Georgia,serif">
        Photographs
      </h2>

      <p class="meta">
        Field photo, close-up, scale photo, processed pigment photo, etc.
      </p>

      <input
        id="photos"
        type="file"
        accept="image/*"
        capture="environment"
        multiple>

      <div
        id="photoGallery"
        class="gallery"
        style="margin-top:10px">
      </div>

    </div>


    <!-- PROCESSING -->

    <div class="card">

      <h2 style="font-family:Georgia,serif">
        Pigment processing
      </h2>

      <p class="meta">
        Processing records will be connected to this specimen in the next database layer.
        These fields are prepared here so the field guide can follow the material from raw
        earth through finished pigment.
      </p>

      <div class="grid">

        <div>
          <label>Processing method</label>
          <input
            id="process"
            placeholder="Dry → crush → sieve → wash → settle → dry…">
        </div>

        <div>
          <label>Particle / sieve size</label>
          <input id="particle">
        </div>

        <div>
          <label>Starting mass</label>
          <input
            id="startingMass"
            placeholder="e.g. 100 g">
        </div>

        <div>
          <label>Final pigment mass</label>
          <input
            id="finalMass"
            placeholder="e.g. 18 g">
        </div>

        <div>
          <label>Yield</label>
          <input
            id="yield"
            placeholder="e.g. 18%">
        </div>

        <div>
          <label>Pigment color</label>
          <input id="pigmentColor">
        </div>

        <div>
          <label>Binder tested</label>
          <input
            id="binder"
            placeholder="Gum arabic, egg, oil, casein…">
        </div>

        <div>
          <label>Lightfastness test</label>
          <input
            id="lightfast"
            placeholder="Method / result / duration">
        </div>

        <div class="full">

          <label>Test / paint notes</label>

          <textarea
            id="testNotes"
            placeholder="Opacity, transparency, tinting strength, granulation, texture, drying behavior…">
          </textarea>

        </div>

        <div class="full">

          <label>Tags</label>

          <input
            id="tags"
            placeholder="ochre, iron, coastal, Oregon, high-yield">

        </div>

      </div>

    </div>


    <div class="row">

      <button onclick="save()">
        Save specimen
      </button>

      <button
        class="secondary"
        onclick="show('list')">
        Cancel
      </button>

      <button
        id="deleteBtn"
        class="danger right hidden"
        onclick="removeCurrent()">
        Delete
      </button>

    </div>

  </section>


  <p class="source-note">
    Oregon Pigment Project specimens are stored in the shared project database.
    Private specimens are protected by Supabase access rules and are visible only
    to the account that created them. Public specimens can be browsed by anyone.
  </p>

</main>


<!-- SUPABASE -->

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<script>

/* -----------------------------
   STATE  (declared first, before anything that could throw,
   so the rest of the script never hits a "used before
   initialization" error if setup below fails)
----------------------------- */

let session = null;
let current = null;
let photoFiles = [];
let authMode = 'signup';
let dbClient = null;


const SUPABASE_URL =
  'https://xzvxligqjkheqmxtniyo.supabase.co';

const SUPABASE_KEY =
  'sb_publishable_X7HdwmQMT3gPmKmAoPTQhA_WCz-RrUA';


/* -----------------------------
   HELPERS
----------------------------- */

const $ = id =>
  document.getElementById(id);


function newCatalogId(){

  const year =
    new Date().getFullYear();

  const number =
    String(
      Math.floor(Math.random()*9000)+1000
    );

  return `OR-${year}-${number}`;
}


function esc(value){

  return String(value ?? '')
    .replace(/[&<>"']/g, m => ({
      '&':'&amp;',
      '<':'&lt;',
      '>':'&gt;',
      '"':'&quot;',
      "'":'&#39;'
    }[m]));

}


function notice(message, ok=true){

  const el =
    $('status');

  el.textContent =
    message;

  el.className =
    'notice ' +
    (ok ? 'success' : 'error');

  el.classList.remove('hidden');

  clearTimeout(window._noticeTimer);

  window._noticeTimer =
    setTimeout(() => {
      el.classList.add('hidden');
    },6000);

}


/* -----------------------------
   SUPABASE CLIENT SETUP
   Wrapped in its own guarded step: if the CDN script didn't
   load (blocked by a network/extension) or the client can't
   be created, the page says so instead of leaving the auth
   buttons silently non-functional.
----------------------------- */

function initClient(){

  if(typeof window.supabase === 'undefined'){

    notice(
      'The Supabase library did not load, so sign-in is unavailable right now. Check your connection and reload.',
      false
    );

    return false;

  }

  try{

    const { createClient } =
      window.supabase;

    dbClient =
      createClient(
        SUPABASE_URL,
        SUPABASE_KEY
      );

    return true;

  }catch(error){

    console.error(error);

    notice(
      'Could not connect to the specimen database: ' +
      error.message,
      false
    );

    return false;

  }

}


/* -----------------------------
   AUTH
----------------------------- */

async function initAuth(){

  if(!initClient()){

    // Buttons stay visible and clickable, but auth calls
    // will fail gracefully via the try/catch blocks below
    // rather than throwing on page load.
    updateAuthUI();

    return;

  }

  try{

    const result =
      await dbClient.auth.getSession();

    session =
      result.data.session;

    updateAuthUI();

    await render();

    dbClient.auth.onAuthStateChange(
      async (_event,newSession) => {

        session =
          newSession;

        updateAuthUI();

        await render();

      }
    );

  }catch(error){

    console.error(error);

    notice(
      'Could not reach the specimen database: ' +
      error.message,
      false
    );

    updateAuthUI();

  }

}


function updateAuthUI(){

  const signedIn =
    !!session;

  $('signInBtn')
    .classList.toggle(
      'hidden',
      signedIn
    );

  $('signUpBtn')
    .classList.toggle(
      'hidden',
      signedIn
    );

  $('signOutBtn')
    .classList.toggle(
      'hidden',
      !signedIn
    );

  $('authUser').textContent =
    signedIn
      ? session.user.email
      : '';

  $('loginNotice')
    .classList.toggle(
      'hidden',
      signedIn
    );

}


function showAuth(mode){

  authMode =
    mode;

  $('authView')
    .classList.remove('hidden');

  $('listView')
    .classList.add('hidden');

  $('formView')
    .classList.add('hidden');

  updateAuthForm();

  window.scrollTo({
    top:0,
    behavior:'smooth'
  });

}


function updateAuthForm(){

  const signup =
    authMode === 'signup';

  $('authTitle').textContent =
    signup
      ? 'Create your OPP account'
      : 'Sign in to OPP';

  $('authDescription').textContent =
    signup
      ? 'Create an account to save specimens to the Oregon Pigment Project database. Your private specimens remain visible only to you.'
      : 'Sign in to access your private collection and add new specimens.';

  $('authSubmit').textContent =
    signup
      ? 'Create account'
      : 'Sign in';

  $('authSwitch').textContent =
    signup
      ? 'Already have an account?'
      : 'Need an account?';

  $('authPassword')
    .autocomplete =
    signup
      ? 'new-password'
      : 'current-password';

  $('authMessage').textContent =
    '';

}


function switchAuthMode(){

  authMode =
    authMode === 'signup'
      ? 'signin'
      : 'signup';

  updateAuthForm();

}


async function submitAuth(){

  if(!dbClient){

    $('authMessage').textContent =
      'The database connection is not available right now. Reload the page and try again.';

    return;

  }

  const email =
    $('authEmail').value.trim();

  const password =
    $('authPassword').value;

  if(!email || !password){

    $('authMessage').textContent =
      'Enter your email and password.';

    return;

  }

  $('authMessage').textContent =
    'Working…';

  if(authMode === 'signup'){

    const {data,error} =
      await dbClient.auth.signUp({
        email,
        password,
        options:{
          // Use the domain this page is actually running on,
          // instead of a hardcoded domain that likely doesn't
          // match your GitHub Pages / custom domain. That
          // mismatch is a common reason confirmation links
          // and signed-in state never make it back to the app.
          emailRedirectTo:
            window.location.origin +
            window.location.pathname
        }
      });

    if(error){

      $('authMessage').textContent =
        error.message;

      return;

    }

    if(data.session){

      $('authMessage').textContent =
        'Account created. You are signed in.';

      return;

    }

    $('authMessage').textContent =
      'Account created. Check your email to confirm your account, then sign in.';

  }else{

    const {error} =
      await dbClient.auth.signInWithPassword({
        email,
        password
      });

    if(error){

      $('authMessage').textContent =
        error.message;

      return;

    }

    show('list');

    notice(
      'Signed in successfully.',
      true
    );

  }

}


async function signOut(){

  if(!dbClient)
    return;

  await dbClient.auth.signOut();

  session =
    null;

  show('list');

  notice(
    'You have been signed out.',
    true
  );

}


/* -----------------------------
   NAVIGATION
----------------------------- */

function show(which,id){

  $('authView')
    .classList.toggle(
      'hidden',
      which !== 'auth'
    );

  $('listView')
    .classList.toggle(
      'hidden',
      which !== 'list'
    );

  $('formView')
    .classList.toggle(
      'hidden',
      which !== 'form'
    );

  if(which === 'list'){

    render();

  }

  if(which === 'form'){

    openForm(id);

  }

}


function requireAuthForNew(){

  if(!session){

    showAuth('signup');

    notice(
      'Create an account before adding a specimen.',
      false
    );

    return;

  }

  show('form');

}


/* -----------------------------
   DATABASE
----------------------------- */

async function fetchSpecimens(){

  if(!dbClient)
    return [];

  let query =
    dbClient
      .from('specimens')
      .select('*')
      .order(
        'collection_date',
        {ascending:false}
      );

  if(session){

    const {data,error} =
      await query;

    if(error)
      throw error;

    return data || [];

  }

  const {data,error} =
    await dbClient
      .from('specimens')
      .select('*')
      .eq('public_share',true)
      .order(
        'collection_date',
        {ascending:false}
      );

  if(error)
    throw error;

  return data || [];

}


function dbToUi(x){

  return {

    id:x.catalog_id,

    dbId:x.id,

    stage:x.stage,

    date:x.collection_date,

    collector:x.collector,

    source:x.source,

    name:x.working_name,

    material:x.material,

    geology:x.geologic_setting,

    locality:x.locality,

    lat:x.gps_lat,

    lon:x.gps_lon,

    color:x.raw_color,

    colorCode:x.color_code,

    texture:x.texture,

    luster:x.luster,

    hardness:x.hardness,

    streak:x.streak,

    magnetic:x.magnetic,

    reaction:x.acid_reaction,

    condition:x.condition,

    quantity:x.quantity,

    storage:x.storage_location,

    notes:x.collection_notes,

    publicShare:x.public_share,

    tags:x.tags,

    userId:x.user_id

  };

}


function formToDb(){

  return {

    catalog_id:
      $('specimenId').textContent,

    stage:
      $('stage').value,

    collection_date:
      $('date').value || null,

    collector:
      $('collector').value.trim() || null,

    source:
      $('source').value.trim() || null,

    working_name:
      $('name').value.trim() || null,

    material:
      $('material').value.trim() || null,

    geologic_setting:
      $('geology').value.trim() || null,

    locality:
      $('locality').value.trim() || null,

    gps_lat:
      numberOrNull($('lat').value),

    gps_lon:
      numberOrNull($('lon').value),

    raw_color:
      $('color').value.trim() || null,

    color_code:
      $('colorCode').value.trim() || null,

    texture:
      $('texture').value.trim() || null,

    luster:
      $('luster').value.trim() || null,

    hardness:
      $('hardness').value.trim() || null,

    streak:
      $('streak').value.trim() || null,

    magnetic:
      $('magnetic').value || null,

    acid_reaction:
      $('reaction').value.trim() || null,

    condition:
      $('condition').value.trim() || null,

    quantity:
      $('quantity').value.trim() || null,

    storage_location:
      $('storage').value.trim() || null,

    collection_notes:
      $('notes').value.trim() || null,

    public_share:
      $('publicShare').checked,

    tags:
      $('tags').value.trim() || null,

    user_id:
      session.user.id

  };

}


function numberOrNull(value){

  if(value === '')
    return null;

  const n =
    Number(value);

  return Number.isFinite(n)
    ? n
    : null;

}


/* -----------------------------
   COLLECTION DISPLAY
----------------------------- */

async function render(){

  const list =
    $('list');

  if(!list)
    return;

  try{

    const rows =
      await fetchSpecimens();

    const specimens =
      rows.map(dbToUi);

    const q =
      $('search').value
        .toLowerCase()
        .trim();

    const filter =
      $('filter').value;

    const visibility =
      $('visibility').value;

    let arr =
      specimens.filter(x => {

        const matchesSearch =
          !q ||
          JSON.stringify(x)
            .toLowerCase()
            .includes(q);

        const matchesFilter =
          !filter ||
          x.stage === filter;

        let matchesVisibility =
          true;

        if(visibility === 'public'){
          matchesVisibility =
            !!x.publicShare;
        }

        if(visibility === 'mine'){

          matchesVisibility =
            !!session &&
            x.userId === session.user.id;

        }

        return (
          matchesSearch &&
          matchesFilter &&
          matchesVisibility
        );

      });


    if(!arr.length){

      list.innerHTML =
        `<div class="notice">
          ${
            session
              ? 'No specimens found yet. Use "+ New Specimen" to begin your collection.'
              : 'No public specimens are available yet. Create an account to start your own collection.'
          }
        </div>`;

      return;

    }


    list.innerHTML =
      arr.map(renderCard).join('');

  }catch(error){

    console.error(error);

    list.innerHTML =
      `<div class="notice error">
        Could not load specimens. ${esc(error.message)}
      </div>`;

  }

}


function renderCard(x){

  const own =
    session &&
    x.userId === session.user.id;

  const location =
    x.locality ||
    'Locality not recorded';

  const tags =
    (x.tags || '')
      .split(',')
      .map(t=>t.trim())
      .filter(Boolean)
      .map(
        t =>
          `<span class="tag">${esc(t)}</span>`
      )
      .join('');

  return `

    <div class="card specimen">

      <div
        class="thumb"
        style="
          display:flex;
          align-items:center;
          justify-content:center;
          color:#8c806d;
          font-size:11px;
          text-align:center;
          padding:8px;
        ">
        OPP<br>
        ${esc(x.color || 'specimen')}
      </div>

      <div>

        <div class="meta">
          ${esc(x.id || '')}
          ·
          ${esc(x.stage || '')}
          ·
          ${esc(x.date || 'No date')}

          ${
            x.publicShare
              ? ' · PUBLIC'
              : own
                ? ' · PRIVATE'
                : ''
          }

        </div>

        <h3>
          ${esc(x.name || 'Unnamed specimen')}
        </h3>

        <div>
          ${esc(x.material || 'Unknown material')}
          ·
          ${esc(location)}
        </div>

        ${
          x.color
            ? `<div class="meta" style="margin-top:4px">
                Field color: ${esc(x.color)}
               </div>`
            : ''
        }

        ${
          tags
            ? `<div class="tags">${tags}</div>`
            : ''
        }

        <div style="margin-top:10px">

          ${
            own
              ? `<button onclick="show('form','${esc(x.id)}')">
                   Open
                 </button>`
              : ''
          }

        </div>

      </div>

    </div>

  `;

}


/* -----------------------------
   SPECIMEN FORM
----------------------------- */

async function openForm(id){

  if(!session){

    showAuth('signup');

    return;

  }

  current =
    null;

  photoFiles =
    [];

  $('formTitle').textContent =
    id
      ? 'Edit specimen'
      : 'New specimen';

  $('deleteBtn')
    .classList.toggle(
      'hidden',
      !id
    );


  if(id){

    const {data,error} =
      await dbClient
        .from('specimens')
        .select('*')
        .eq('catalog_id',id)
        .eq('user_id',session.user.id)
        .single();

    if(error){

      notice(
        'Could not open that specimen: ' +
        error.message,
        false
      );

      show('list');

      return;

    }

    current =
      dbToUi(data);

    current.dbId =
      data.id;

    fillForm(current);

  }else{

    fillForm({

      id:newCatalogId(),

      date:new Date()
        .toISOString()
        .slice(0,10),

      stage:'Raw material',

      publicShare:false

    });

  }

}


function fillForm(x){

  current =
    x;

  $('specimenId').textContent =
    x.id || newCatalogId();

  $('stage').value =
    x.stage || 'Raw material';

  $('date').value =
    x.date || '';

  $('collector').value =
    x.collector || '';

  $('source').value =
    x.source || '';

  $('name').value =
    x.name || '';

  $('material').value =
    x.material || '';

  $('geology').value =
    x.geology || '';

  $('locality').value =
    x.locality || '';

  $('lat').value =
    x.lat ?? '';

  $('lon').value =
    x.lon ?? '';

  $('color').value =
    x.color || '';

  $('colorCode').value =
    x.colorCode || '';

  $('texture').value =
    x.texture || '';

  $('luster').value =
    x.luster || '';

  $('hardness').value =
    x.hardness || '';

  $('streak').value =
    x.streak || '';

  $('magnetic').value =
    x.magnetic || '';

  $('reaction').value =
    x.reaction || '';

  $('condition').value =
    x.condition || '';

  $('quantity').value =
    x.quantity || '';

  $('storage').value =
    x.storage || '';

  $('notes').value =
    x.notes || '';

  $('publicShare').checked =
    !!x.publicShare;

  $('tags').value =
    x.tags || '';

  renderPhotos([]);

}


/* -----------------------------
   PHOTOS
----------------------------- */

function renderPhotos(){

  $('photoGallery').innerHTML =
    '';

  if(!photoFiles.length){

    $('photoGallery').innerHTML =
      `<div class="meta">
        Photos are ready for the next Supabase Storage layer.
       </div>`;

    return;

  }

  photoFiles.forEach(
    (photo,index)=>{

      const div =
        document.createElement('div');

      div.innerHTML =
        `
        <img src="${photo}">
        <button
          class="danger"
          style="margin-top:4px;width:100%"
          onclick="removePhoto(${index})">
          Remove
        </button>
        `;

      $('photoGallery')
        .appendChild(div);

    }
  );

}


function removePhoto(index){

  photoFiles.splice(
    index,
    1
  );

  renderPhotos();

}


$('photos').addEventListener(
  'change',
  async event => {

    for(
      const file of event.target.files
    ){

      const data =
        await resize(file);

      photoFiles.push(data);

    }

    renderPhotos();

    event.target.value =
      '';

  }
);


function resize(file){

  return new Promise(resolve => {

    const img =
      new Image();

    const canvas =
      document.createElement('canvas');

    const reader =
      new FileReader();

    reader.onload =
      () => {

        img.onload =
          () => {

            const max =
              1600;

            const scale =
              Math.min(
                1,
                max /
                Math.max(
                  img.width,
                  img.height
                )
              );

            canvas.width =
              img.width * scale;

            canvas.height =
              img.height * scale;

            canvas
              .getContext('2d')
              .drawImage(
                img,
                0,
                0,
                canvas.width,
                canvas.height
              );

            resolve(
              canvas.toDataURL(
                'image/jpeg',
                .82
              )
            );

          };

        img.src =
          reader.result;

      };

    reader.readAsDataURL(file);

  });

}


/* -----------------------------
   SAVE
----------------------------- */

async function save(){

  if(!session){

    showAuth('signup');

    return;

  }


  const record =
    formToDb();


  if(!record.working_name){

    notice(
      'Give this specimen a name before saving.',
      false
    );

    $('name').focus();

    return;

  }


  try{

    let result;


    if(current && current.dbId){

      result =
        await dbClient
          .from('specimens')
          .update(record)
          .eq(
            'id',
            current.dbId
          )
          .eq(
            'user_id',
            session.user.id
          );

    }else{

      result =
        await dbClient
          .from('specimens')
          .insert(record);

    }


    if(result.error)
      throw result.error;


    show('list');

    notice(
      `Saved ${record.working_name}.`,
      true
    );


  }catch(error){

    console.error(error);

    notice(
      'Could not save specimen: ' +
      error.message,
      false
    );

  }

}


/* -----------------------------
   DELETE
----------------------------- */

async function removeCurrent(){

  if(!session || !current || !current.dbId)
    return;


  if(
    !confirm(
      'Delete this specimen permanently?'
    )
  )
    return;


  try{

    const {error} =
      await dbClient
        .from('specimens')
        .delete()
        .eq(
          'id',
          current.dbId
        )
        .eq(
          'user_id',
          session.user.id
        );


    if(error)
      throw error;


    current =
      null;

    show('list');

    notice(
      'Specimen deleted.',
      true
    );


  }catch(error){

    notice(
      'Could not delete specimen: ' +
      error.message,
      false
    );

  }

}


/* -----------------------------
   GPS
----------------------------- */

function locate(){

  if(!navigator.geolocation){

    $('locStatus').textContent =
      'GPS unavailable';

    return;

  }


  $('locStatus').textContent =
    'Requesting location…';


  navigator.geolocation.getCurrentPosition(

    position => {

      $('lat').value =
        position.coords.latitude
          .toFixed(6);

      $('lon').value =
        position.coords.longitude
          .toFixed(6);

      $('locStatus').textContent =
        'Location captured';

    },

    error => {

      $('locStatus').textContent =
        'Could not capture: ' +
        error.message;

    },

    {
      enableHighAccuracy:true,
      timeout:10000
    }

  );

}


/* -----------------------------
   LOCAL BACKUP
----------------------------- */

async function backup(){

  if(!session){

    notice(
      'Sign in to create a private backup.',
      false
    );

    return;

  }


  try{

    const rows =
      await fetchSpecimens();

    const mine =
      rows.filter(
        x =>
          x.user_id ===
          session.user.id
      );


    if(!mine.length){

      notice(
        'You have no specimens to back up yet.',
        false
      );

      return;

    }


    const data =
      JSON.stringify(
        mine,
        null,
        2
      );


    const a =
      document.createElement('a');

    a.href =
      URL.createObjectURL(
        new Blob(
          [data],
          {type:'application/json'}
        )
      );

    a.download =
      'oregon-pigment-private-backup.json';

    a.click();


    notice(
      `Backup downloaded: ${mine.length} specimen(s).`,
      true
    );


  }catch(error){

    notice(
      'Backup failed: ' +
      error.message,
      false
    );

  }

}


/* -----------------------------
   PUBLIC EXPORT
----------------------------- */

async function exportPublic(){

  if(!dbClient){

    notice(
      'The database connection is not available right now.',
      false
    );

    return;

  }

  try{

    const rows =
      await dbClient
        .from('specimens')
        .select(
          'catalog_id,stage,collection_date,working_name,material,geologic_setting,locality,raw_color,color_code,texture,luster,hardness,streak,magnetic,acid_reaction,tags,public_share'
        )
        .eq(
          'public_share',
          true
        );


    if(rows.error)
      throw rows.error;


    if(!rows.data.length){

      notice(
        'No specimens are marked public yet.',
        false
      );

      return;

    }


    const safe =
      rows.data.map(x => ({

        id:x.catalog_id,

        stage:x.stage,

        date:x.collection_date,

        name:x.working_name,

        material:x.material,

        geology:x.geologic_setting,

        locality:x.locality,

        color:x.raw_color,

        colorCode:x.color_code,

        texture:x.texture,

        luster:x.luster,

        hardness:x.hardness,

        streak:x.streak,

        magnetic:x.magnetic,

        reaction:x.acid_reaction,

        tags:x.tags

      }));


    const data =
      JSON.stringify(
        {
          project:
            'Oregon Pigment Project Field Guide',

          exported:
            new Date().toISOString(),

          specimens:
            safe
        },
        null,
        2
      );


    const a =
      document.createElement('a');

    a.href =
      URL.createObjectURL(
        new Blob(
          [data],
          {type:'application/json'}
        )
      );

    a.download =
      'oregon-pigment-public-catalog.json';

    a.click();


    notice(
      `Exported ${safe.length} public specimen(s).`,
      true
    );


  }catch(error){

    notice(
      'Public export failed: ' +
      error.message,
      false
    );

  }

}


/* -----------------------------
   FILTERS
----------------------------- */

$('search')
  .addEventListener(
    'input',
    render
  );

$('filter')
  .addEventListener(
    'change',
    render
  );

$('visibility')
  .addEventListener(
    'change',
    render
  );


/* -----------------------------
   START
----------------------------- */

initAuth();

</script>

</body>
</html>
